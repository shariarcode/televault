# ============================================================================
# TeleVault Environment Configuration (.env.example)
# ============================================================================
# SECURITY NOTICE:
# NEVER commit your real `.env` file or hardcode `api_id`, `api_hash`, or raw
# Telegram MTProto session strings inside the Flutter client source code.
#
# Copy this file to `.env` or configure the Bridge URL directly inside the
# TeleVault app under Telegram Cloud -> Bridge Configuration.
# ============================================================================

# Base URL of your self-hosted Telegram MTProto Client Bridge (e.g., Telethon / Pyrogram / GramJS / TDLib)
TELEVAULT_BRIDGE_URL=https://bridge.your-domain.example.com

# Optional client identifier header for bridge rate-limiting / request signing
TELEVAULT_CLIENT_ID=televault-mobile-v1

# Default target chat in the user's Telegram account ("me" = Saved Messages)
TELEVAULT_TARGET_CHAT=me

# Demo / Offline Simulation Mode ("true" allows testing the full Phone -> OTP -> 2FA -> Upload flow without a live server)
TELEVAULT_DEMO_MODE=true

